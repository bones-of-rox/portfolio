---
// The gallery moved to /fab-lab/. This keeps old shared links to each piece working.
import { getCollection } from 'astro:content';
import { url } from '../../utils';

export async function getStaticPaths() {
  const pieces = await getCollection('made', ({ data }) => !data.draft);
  return pieces.map((piece) => ({ params: { slug: piece.id } }));
}

return Astro.redirect(url(`/fab-lab/${Astro.params.slug}/`), 301);
---
