---
import { Image, getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils';
import { coverTone } from '../../cover-tone';

export async function getStaticPaths() {
  const pieces = (await getCollection('made', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return pieces.map((piece, i) => ({
    params: { slug: piece.id },
    props: { piece, newer: pieces[i - 1], older: pieces[i + 1] },
  }));
}

interface Props {
  piece: CollectionEntry<'made'>;
  newer?: CollectionEntry<'made'>;
  older?: CollectionEntry<'made'>;
}

const { piece, newer, older } = Astro.props;
const { title, summary, type, date, dateLabel, madeFor, materials, tools, size, cover, coverFocus, coverPlain, coverLight, coverAlign, coverPad, photos, photoLayout, videos } =
  piece.data;
const { Content } = await render(piece);
const hasStory = Boolean(piece.body?.trim());
const tone = coverPlain ? { tint: 'transparent', strength: 0 } : await coverTone(piece.id);

const facts = [
  { label: 'Type', value: type },
  { label: 'When', value: dateLabel ?? String(date.getFullYear()) },
  { label: 'Made for', value: madeFor },
  { label: 'Materials', value: materials?.join(', ') },
  { label: 'Tools', value: tools?.join(', ') },
  { label: 'Size', value: size },
].filter((fact) => fact.value);

const videoList = await Promise.all(
  videos.map(async (v) => ({
    ...v,
    base: url(`/made/${piece.id}/${v.src}`),
    poster: await getImage({ src: v.poster, width: 960, format: 'webp' }),
  })),
);
---

<BaseLayout title={title} description={summary} plain overlayHeader lightHeader={coverLight} light>
  <article class="piece">
    <!-- Top photo runs edge to edge and up under the site header, with the title on it -->
    <header
      class:list={['piece-hero', { 'is-plain': coverPlain, 'is-light': coverLight, 'is-content': coverAlign === 'content' }]}
      style={`--cover-tint: ${tone.tint}; --cover-tint-strength: ${tone.strength}; --cover-focus: ${coverFocus ?? '50% 50%'}; --cover-pad: ${coverPad}; --hero-paper: url(${url('/textures/paper.jpg')})`}
    >
      {
        /* Sized to the text column, so the object lines up with the text edges below */
        coverAlign === 'content' ? (
          <div class="piece-cover-frame container">
            <Image
              src={cover.src}
              alt={cover.alt}
              widths={[480, 800, 1200, 1600, 2400]}
              sizes="(min-width: 80em) 1400px, 130vw"
              class="piece-cover-inset"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        ) : (
          <Image
            src={cover.src}
            alt={cover.alt}
            widths={[480, 800, 1200, 1600, 2400]}
            sizes="100vw"
            class="piece-cover"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      <div class="piece-hero-text container">
        <h1>{title}</h1>
      </div>
    </header>

    <div class="container piece-main">

    <div class="piece-body">
      {
        hasStory && (
          <section class="piece-story" aria-labelledby="story-heading">
            <!-- Same look as the Type and When labels -->
            <h2 id="story-heading" class="story-label">Background</h2>
            <div class="story-text">
              <Content />
            </div>
          </section>
        )
      }

      <section class="facts" aria-labelledby="facts-heading">
        <!-- Heading stays for screen readers, hidden on screen -->
        <h2 id="facts-heading" class="visually-hidden">Quick facts</h2>
        <dl>
          {
            facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    {
      photos.length > 0 && (
        <section class="photos" aria-labelledby="photos-heading">
          <h2 id="photos-heading" class="visually-hidden">Photos</h2>
          <ul class:list={['photo-grid', { 'photo-grid-even': photoLayout === 'grid' }]} role="list">
            {photos.map((photo) => (
              <li class={photoLayout === 'mixed' && photo.src.width > photo.src.height ? 'tile tile-wide' : 'tile'}>
                <figure>
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 40em) 50vw, 100vw"
                    class="photo"
                  />
                  {photo.caption && <figcaption>{photo.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      videoList.length > 0 && (
        <div class="videos">
          {videoList.map((v, i) => (
            <section class="video" aria-labelledby={`video-heading-${i}`}>
              {v.title ? (
                <h2 id={`video-heading-${i}`} class="video-title">{v.title}</h2>
              ) : (
                <h2 id={`video-heading-${i}`} class="visually-hidden">Video</h2>
              )}
              <figure>
                <video
                  controls
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={v.poster.src}
                  class="video-player"
                  aria-describedby={`video-description-${i}`}
                >
                  <source src={`${v.base}.webm`} type="video/webm" />
                  <source src={`${v.base}.mp4`} type="video/mp4" />
                </video>
                {/* Description stays for screen readers only (hidden on screen per Donovan, 2026-11-09) */}
                <figcaption id={`video-description-${i}`} class="visually-hidden">{v.description}</figcaption>
              </figure>
            </section>
          ))}
        </div>
      )
    }

    {
      (newer || older) && (
        <nav class="pager" aria-label="More 3D projects">
          {older && (
            <a class="pager-link" href={url(`/fab-lab/${older.id}/`)}>
              <span class="pager-label">Previous</span>
              <span class="pager-title">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="pager-link pager-next" href={url(`/fab-lab/${newer.id}/`)}>
              <span class="pager-label">Next</span>
              <span class="pager-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
    </div>
  </article>
</BaseLayout>

<style>
  .piece {
    display: grid;
    gap: var(--space-10);
  }

  .piece-main {
    display: grid;
    gap: var(--space-10);
    width: 100%;
  }

  /* ---------- Full-bleed top photo with the title on it ---------- */
  .piece-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: var(--hero-height);
    overflow: hidden;
    isolation: isolate;
    color: var(--color-on-photo);
    box-shadow: var(--hero-shadow);
  }

  .piece-cover {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cover-focus);
  }

  /* coverAlign: content. Paper texture fills the window; the image sits in the text column.
     The image is wider than the column by its paper padding, pulled left by the same amount,
     and its edges fade into the paper so no seam shows. */
  .piece-hero.is-content {
    background-color: var(--color-paper);
    background-image: var(--hero-paper);
    /* Scale the paper grain to match the image: the 480px tile was cut from a 1800px-wide render */
    background-size: calc(
        (min(100vw, var(--content-max)) - 2 * var(--gutter)) * (1 + 2 * var(--cover-pad)) * 480 / 1800
      )
      auto;
  }

  .piece-cover-frame {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    z-index: -3;
    transform: translateY(-50%);
  }

  .piece-cover-inset {
    display: block;
    width: calc(100% * (1 + 2 * var(--cover-pad)));
    max-width: none;
    height: auto;
    margin-left: calc(-100% * var(--cover-pad));
    -webkit-mask-image:
      linear-gradient(to right, transparent, var(--mask-opaque) 8%, var(--mask-opaque) 92%, transparent),
      linear-gradient(to bottom, transparent, var(--mask-opaque) 20%, var(--mask-opaque) 80%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, var(--mask-opaque) 8%, var(--mask-opaque) 92%, transparent),
      linear-gradient(to bottom, transparent, var(--mask-opaque) 20%, var(--mask-opaque) 80%, transparent);
    mask-composite: intersect;
  }

  /* Soft wash in the photo's own tone: turns bright whites a gentle color */
  .piece-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-color: var(--cover-tint);
    opacity: var(--cover-tint-strength);
    mix-blend-mode: multiply;
  }

  /* A shade only at the top, behind the site name; no band at the bottom */
  .piece-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(
      to bottom,
      var(--photo-scrim-top) 0%,
      var(--photo-scrim-top) 14%,
      transparent 32%
    );
  }

  .piece-hero-text {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-24);
    padding-bottom: var(--space-10);
    text-shadow: var(--photo-text-shadow);
  }

  /* Light top photo: dark title, no drop shadow, no dark shade at the top */
  .piece-hero.is-light {
    --color-on-photo: var(--color-on-light-photo);
    --color-focus: var(--color-on-light-photo);
    --photo-text-shadow: none;
    --photo-text-shadow-small: none;
  }

  .piece-hero.is-light::after {
    display: none;
  }

  /* A lighter weight for the big project title */
  .piece-hero h1 {
    font-weight: var(--weight-light);
  }

  .piece-body {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 64em) {
    .piece-body {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }

    /* Line up the Background label with the Type label inside the facts box */
    .piece-story {
      padding-top: var(--space-6);
    }
  }

  .piece-story {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  /* Matches the Type and When labels in the facts box */
  .story-label,
  .fact dt {
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-highlight);
  }

  .story-text {
    display: grid;
    gap: var(--space-5);
    font-size: var(--text-lg);
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .facts dl {
    display: grid;
    gap: var(--space-3);
  }

  .fact {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .fact:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .fact dd {
    margin: 0;
  }

  .videos {
    display: grid;
    gap: var(--space-10) var(--space-6);
  }

  @media (min-width: 40em) {
    .videos {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .video {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .video-title {
    font-size: var(--text-2xl);
  }

  .photo-grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
  }

  @media (min-width: 40em) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Tiles: tall photos sit side by side as 4:5 tiles, wide photos span the row */
  .photo {
    width: 100%;
    border-radius: var(--radius-md);
  }

  .tile:not(.tile-wide) .photo {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (min-width: 40em) {
    .tile-wide {
      grid-column: 1 / -1;
    }
  }

  /* Even grid: square tiles, two across on phones, up to four on wide screens */
  .photo-grid-even {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .photo-grid-even .tile .photo {
    aspect-ratio: 1;
  }

  @media (min-width: 40em) {
    .photo-grid-even {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .photo-grid-even {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  figure {
    display: grid;
    gap: var(--space-2);
  }

  figcaption {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .video-player {
    width: 100%;
    max-width: 36rem;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .pager {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  @media (min-width: 40em) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pager-link {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }

  .pager-link:hover {
    background-color: var(--color-surface-raised);
  }

  .pager-next {
    text-align: end;
    grid-column: -2;
  }

  .pager-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pager-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }
</style>
