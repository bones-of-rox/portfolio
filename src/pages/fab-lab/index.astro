---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
---

<BaseLayout
  title="3D"
  description="3D-printed products and furniture made by Donovan Preddy."
>
  <div class="container made">
    <header class="made-intro">
      <h1>3D</h1>
      <p class="lead">Things I design and build that can be touched and held.</p>
    </header>

    <ProjectGrid />
  </div>
</BaseLayout>

<style>
  .made {
    display: grid;
    gap: var(--space-10);
    padding-top: var(--space-section);
  }

  .made-intro {
    display: grid;
    gap: var(--space-4);
  }
</style>
