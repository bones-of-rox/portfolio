---
import { url } from '../utils';

// The back button shows on every page except the homepage, which is already the full list
const home = url('/');
const onHome = Astro.url.pathname === home || Astro.url.pathname === `${home}/`;
---

<header class="site-header">
  <div class="container">
    <div class="site-header-inner">
      <div class="brand">
        <a class="site-name" href={home}>Projeks</a>
        {/* Decorative: hand + mouse + gear, after an orange rule. Hidden from screen readers.
            Mouse and gear are from Lucide (ISC license, lucide.dev); the hand is drawn to match Donovan's mockup. */}
        <span class="brand-icons" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M5 14V8a1.75 1.75 0 0 1 3.5 0V5a1.75 1.75 0 0 1 3.5 0v-.5a1.75 1.75 0 0 1 3.5 0V6a1.75 1.75 0 0 1 3.5 0v8a7 7 0 0 1-14 0Z" />
            <path d="M8.5 8v4M12 5v6M15.5 6v5" />
          </svg>
          <span class="brand-plus">+</span>
          <svg viewBox="0 0 24 24" focusable="false">
            <rect x="5" y="2" width="14" height="20" rx="7" />
            <path d="M12 6v4" />
          </svg>
          <span class="brand-plus">+</span>
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </span>
      </div>
    </div>
      {
        !onHome && (
          <a class="back-button" href={home} aria-label="Back to all projects">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="back-label">Back</span>
          </a>
        )
      }
  </div>
</header>

<style>
  /* Name on top with a rule under it; the back button sits below the rule, on the left */
  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-8);
    padding-block: var(--space-4) var(--space-3);
    border-bottom: var(--border-width) solid var(--color-header-rule);
  }

  /* Title, then an orange rule, then the hand + mouse + gear icons (mockup 2026-11-22) */
  .brand {
    display: flex;
    align-items: center;
    gap: var(--brand-gap);
    margin-inline-end: auto;
  }

  .brand-icons {
    display: inline-flex;
    align-items: center;
    gap: var(--brand-icon-gap);
    padding-inline-start: var(--brand-gap);
    border-inline-start: var(--brand-rule-width) solid var(--color-header-divider);
    min-height: var(--brand-rule-height);
    color: var(--color-header-icons);
  }

  .brand-icons svg {
    width: var(--brand-icon-size);
    height: var(--brand-icon-size);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--brand-icon-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .brand-plus {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    line-height: 1;
  }

  .site-name {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-name:hover {
    color: var(--color-accent);
  }

  /* Back to the gallery: a plain left arrow with the word "Back" beside it, no background.
     Medium gray over pale renders so it stays quiet, full black on hover; white over dark photos */
  .back-button {
    margin-top: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--back-button-gap);
    min-height: var(--target-min);
    padding-inline-end: var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--back-button-color);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back-button:hover {
    color: var(--back-button-color-hover);
  }

  .back-button svg {
    flex: none;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .back-button:hover .back-label {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  @media (prefers-reduced-motion: no-preference) {
    .back-button:hover svg {
      transform: translateX(calc(-1 * var(--space-1)));
    }
  }
</style>
