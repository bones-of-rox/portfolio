---
import { url } from '../utils';

// "View all" shows on every page except the homepage, which is already the full list
const home = url('/');
const onHome = Astro.url.pathname === home || Astro.url.pathname === `${home}/`;
---

<header class="site-header">
  <div class="container">
    <div class="site-header-inner">
      <a class="site-name" href={home}>Projeks</a>
      {
        !onHome && (
          <a class="view-all" href={home}>
            View all<span class="visually-hidden"> projects</span>
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  /* Name on the left, "View all" on the right, a rule under both */
  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-8);
    padding-block: var(--space-4) var(--space-3);
    border-bottom: var(--border-width) solid var(--color-header-rule);
  }

  .site-name {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    margin-inline-end: auto;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-name:hover {
    color: var(--color-accent);
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  .view-all:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
