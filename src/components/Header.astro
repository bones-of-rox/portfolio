---
import { url } from '../utils';

// The back button shows on every page except the homepage, which is already the full list
const home = url('/');
const onHome = Astro.url.pathname === home || Astro.url.pathname === `${home}/`;
---

<header class="site-header">
  <div class="container">
    <div class="site-header-inner">
      <a class="site-name" href={home}>Projeks</a>
    </div>
      {
        !onHome && (
          <a class="back-button" href={home} aria-label="Back to all projects">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="back-label">Back</span>
          </a>
        )
      }
  </div>
</header>

<style>
  /* Name on top with a rule under it; the back button sits below the rule, on the left */
  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-8);
    padding-block: var(--space-4) var(--space-3);
    border-bottom: var(--border-width) solid var(--color-header-rule);
  }

  .site-name {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    margin-inline-end: auto;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-name:hover {
    color: var(--color-accent);
  }

  /* Back to the gallery: a plain left arrow with the word "Back" beside it, no background.
     Medium gray over pale renders so it stays quiet, full black on hover; white over dark photos */
  .back-button {
    margin-top: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--back-button-gap);
    min-height: var(--target-min);
    padding-inline-end: var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--back-button-color);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back-button:hover {
    color: var(--back-button-color-hover);
  }

  .back-button svg {
    flex: none;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .back-button:hover .back-label {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  @media (prefers-reduced-motion: no-preference) {
    .back-button:hover svg {
      transform: translateX(calc(-1 * var(--space-1)));
    }
  }
</style>
