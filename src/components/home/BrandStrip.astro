---
import { brands } from '../../data/brands';

// Size each logo so they all cover roughly the same area, whatever their shape:
// wide logos get wider and shorter, tall logos narrower and taller.
const sized = brands.map((brand) => ({
  ...brand,
  scale: Math.sqrt(brand.logo.width / brand.logo.height).toFixed(3),
}));
---

<section class="brands" aria-labelledby="brands-heading" data-brand-strip>
  <div class="container">
    <h2 id="brands-heading">Brands I've worked with</h2>
  </div>

  <!--
    A sideways row people can swipe, drag, or move with the arrow keys.
    Scrolling down the page also nudges it gently: logos enter from the right and travel left.
  -->
  <div class="viewport" role="region" aria-label="Brand logos (scrolls sideways)" tabindex="0" data-viewport>
    <ul class="logos" role="list">
      {
        sized.map(({ name, logo, scale }) => (
          <li>
            <img
              src={logo.src}
              alt={name}
              width={logo.width}
              height={logo.height}
              style={`--logo-scale: ${scale}`}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .brands {
    padding-block: var(--space-section);
  }

  h2 {
    margin-bottom: var(--space-10);
  }

  /* Faded edges hint that there's more to see on either side */
  .viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, black var(--space-16), black calc(100% - var(--space-16)), transparent);
  }

  .viewport::-webkit-scrollbar {
    display: none;
  }

  .viewport:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(-1 * var(--focus-width));
    mask-image: none;
  }

  @media (pointer: fine) {
    .viewport {
      cursor: grab;
    }

    .viewport.is-dragging {
      cursor: grabbing;
      user-select: none;
    }
  }

  .logos {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    width: max-content;
    margin: 0;
    padding-block: var(--space-4);
    /* Room past the faded edges, so the first and last logos can show in full */
    padding-inline: calc(var(--gutter) + var(--space-16));
  }

  .logos img {
    display: block;
    width: calc(var(--brand-logo-size) * var(--logo-scale));
    height: auto;
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const PAN_SPEED = 0.5; // the row moves half as far as the page scrolls

  for (const strip of document.querySelectorAll<HTMLElement>('[data-brand-strip]')) {
    const viewport = strip.querySelector<HTMLElement>('[data-viewport]')!;

    // Page scroll nudges the row from wherever it is now (including after a swipe).
    let lastY = window.scrollY;
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const delta = window.scrollY - lastY;
          lastY = window.scrollY;
          ticking = false;
          if (reduced.matches || dragging) return;
          const box = strip.getBoundingClientRect();
          if (box.bottom < 0 || box.top > window.innerHeight) return;
          viewport.scrollLeft += delta * PAN_SPEED; // down = logos move left
        });
      },
      { passive: true },
    );

    // Click and drag with a mouse (touch screens swipe natively).
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      dragging = true;
      startX = event.clientX;
      startScroll = viewport.scrollLeft;
      viewport.setPointerCapture(event.pointerId);
      viewport.classList.add('is-dragging');
    });
    viewport.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      viewport.scrollLeft = startScroll - (event.clientX - startX);
    });
    const stop = () => {
      dragging = false;
      viewport.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup', stop);
    viewport.addEventListener('pointercancel', stop);
  }
</script>
